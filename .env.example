# ATIENDE - Variables de entorno
# Copia este archivo a .env.local y completa los valores
# NUNCA commitees este archivo con valores reales

# ============================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL (SERVIDOR)
# ============================================
# Estas variables SOLO deben existir en el servidor (Vercel)
# NUNCA deben llegar al cliente

# Opciones: openai, anthropic, none
AI_PROVIDER=none

# Clave API del proveedor (MANTENER SECRETA)
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
AI_API_KEY=

# Modelo a usar
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
AI_MODEL=gpt-4o-mini

# ============================================
# VARIABLES PÚBLICAS (CLIENTE)
# ============================================
# Estas variables pueden exponerse al cliente (prefijo VITE_)

# URL de la aplicación
VITE_APP_URL=http://localhost:5173

# Flag para indicar si IA está configurada (solo informativo)
# La clave real está en el servidor
VITE_AI_CONFIGURED=false

# ============================================
# SUPABASE (OPCIONAL - para migrar de localStorage)
# ============================================
# Si se usa Supabase, estas variables son necesarias

# URL del proyecto Supabase
VITE_SUPABASE_URL=

# Clave anónima (pública, segura para cliente)
VITE_SUPABASE_ANON_KEY=

# Clave de servicio (SECRETA, solo servidor)
SUPABASE_SERVICE_KEY=

# ============================================
# ALMACENAMIENTO (OPCIONAL)
# ============================================

# Nombre del bucket en Supabase Storage
STORAGE_BUCKET=atiende-documents

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=10

# ============================================
# LÍMITES DE USO
# ============================================

# Límites por espacio anónimo
MAX_MISSIONS_PER_SPACE=50
MAX_DOCUMENTS_PER_MISSION=20
MAX_EXECUTIONS_PER_HOUR=30
MAX_AI_CALLS_PER_DAY=100
MAX_STORAGE_MB=500

# ============================================
# SEGURIDAD
# ============================================

# Dominios permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,https://atiende.vercel.app

# ============================================
# OPCIONAL: OCR para PDFs escaneados
# ============================================

# Proveedor OCR (ej: google_vision, aws_textract)
OCR_PROVIDER=
OCR_API_KEY=

# ============================================
# OPCIONAL: Fuentes externas
# ============================================

# API de búsqueda web
SEARCH_PROVIDER=
SEARCH_API_KEY=
