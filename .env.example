# ATIENDE - Variables de entorno
# Copia este archivo a .env.local y completa los valores

# ============================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL
# ============================================
# Opciones: openai, anthropic, none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ============================================
# SUPABASE (Base de datos + Auth + Storage)
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================
# ALMACENAMIENTO
# ============================================
STORAGE_BUCKET=atiende-documents
MAX_FILE_SIZE_MB=10

# ============================================
# SEGURIDAD
# ============================================
# URL de tu aplicación
NEXT_PUBLIC_APP_URL=http://localhost:5173

# ============================================
# OPCIONAL: OCR para PDFs escaneados
# ============================================
OCR_PROVIDER=
OCR_API_KEY=

# ============================================
# OPCIONAL: Fuentes externas
# ============================================
SEARCH_API_KEY=
SEARCH_PROVIDER=
